// Prisma schema for the Pannico order-intake PoC.
// SQLite is used for PoC simplicity; status is a plain String column
// constrained by the shared OrderStatus union and validated in the service layer
// (SQLite + Prisma do not support native enums).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Catalog product, populated by the seed. `active` lets us retire a product
/// without hard-deleting it (historical OrderItems keep their reference).
model Product {
  id     String  @id @default(cuid())
  name   String
  active Boolean @default(true)

  orderItems OrderItem[]
}

/// A production bloque: the container orders are slotted into. Exactly one
/// bloque is `open` at any time (enforced by app logic plus a partial unique
/// index defined in the migration — Prisma's DSL can't express a partial index).
/// Closing the open bloque atomically opens a fresh one. `seq` is a human-facing
/// display number assigned as max(seq)+1 in the service (SQLite autoincrement is
/// PK-only, and our PK is a cuid).
model Slot {
  id       String    @id @default(cuid())
  seq      Int       @unique
  status   String    @default("open")
  openedAt DateTime  @default(now())
  closedAt DateTime?

  orders Order[]

  @@index([status])
}

/// An order. The single-use token lives on the order (1:1) since a token is
/// bound to exactly one order. `status` follows the shared OrderStatus union.
/// Every order belongs to the bloque that was open when it was created.
model Order {
  id          String    @id @default(cuid())
  phone       String
  token       String    @unique
  status      String    @default("pending")
  slotId      String
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?
  /// Optional raw customer message (e.g. pasted WhatsApp text) captured when a
  /// manager transcribes an order by hand. Null when no message was captured.
  message     String?

  items OrderItem[]
  slot  Slot        @relation(fields: [slotId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([status])
  @@index([slotId])
}

/// A line item recorded on an order at confirmation. References Product so
/// out-of-catalog items are structurally impossible.
model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  productId String
  quantity  Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
}
