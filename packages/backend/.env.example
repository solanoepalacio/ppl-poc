# Prisma / SQLite datasource. Path is relative to the prisma/ directory.
DATABASE_URL="file:./dev.db"

# Base URL of the customer-facing frontend, used to build shareable order links.
FRONTEND_BASE_URL="http://localhost:3001"

# Port the backend listens on.
PORT=3000

# CORS allowlist (comma-separated origins). Leave unset when the backend sits
# behind the Next.js proxy — browser traffic is same-origin and CORS is not
# needed. Set this only if you expose the backend directly to browsers,
# e.g. CORS_ORIGIN="https://app.example.com".
# CORS_ORIGIN=""

# ── WhatsApp order agent (Meta Cloud API) ─────────────────────────────────
# Named META_* so a single .env can serve this and any other project talking to
# the same API. The agent stays inert unless the first four are set: half a
# configuration is worse than none, since an endpoint that verifies but cannot
# reply looks alive while doing the wrong thing. Never commit real values.
#
# App Dashboard → WhatsApp → API Setup. The temporary one there expires in ~23h;
# for anything lasting, generate a System User token in Business Settings.
META_ACCESS_TOKEN=""
# App Dashboard → WhatsApp → API Setup, under "From". The id Meta assigns the
# number, not the number itself.
META_PHONE_NUMBER_ID=""
# A string you invent. It goes here and in the same field of the webhook
# configuration; Meta sends it back once, at registration, to prove the endpoint
# is yours.
META_VERIFY_TOKEN=""
# App Dashboard → App Settings → Basic → App secret. Signs every delivery, and
# is the only thing standing between the public internet and an endpoint that
# mints order links — so it is required, not optional.
META_APP_SECRET=""
# Pinned on purpose: when Meta ships a new version and changes a field, this
# keeps working until we choose to move.
META_API_VERSION="v21.0"
# Override only to point the agent at a mock while testing.
# META_GRAPH_BASE_URL="https://graph.facebook.com"

# Which values are required depends on the provider:
#   ollama    → LLM_MODEL + LLM_BASE_URL   (no key; the server is private)
#   anthropic → LLM_MODEL + LLM_API_KEY    (endpoint defaults)
LLM_PROVIDER="ollama"

LLM_MODEL="qwen3:32b"

LLM_BASE_URL="http://localhost:11434"
# Hosted provider only; leave empty for ollama.
LLM_API_KEY=""
# How long one inference may take before it is abandoned and the message goes
# unanswered.
LLM_TIMEOUT_MS=30000

# ── LangWatch (LLM tracing) ───────────────────────────────────────────────
# Unset means no tracing and a working system — never a failed inference.
#
# Worth setting anyway: because the agent is silent both when it decides "not an
# order" and when it could not decide at all, the trace is the only place those
# two are distinguishable.
LANGWATCH_API_KEY=""
# Override only for a self-hosted LangWatch; the SDK defaults to the hosted one.
# LANGWATCH_ENDPOINT=""
