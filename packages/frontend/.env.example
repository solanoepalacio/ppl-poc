# Browser-side API base. A relative path that Next.js rewrites to the backend
# (see next.config.js), so the backend never needs to be exposed to clients.
# Leave as "/api" unless you intentionally expose the backend directly.
NEXT_PUBLIC_API_BASE_URL="/api"

# Server-side backend address. Used by server components and the Next.js proxy
# to reach the backend over the internal network. Never exposed to the browser.
BACKEND_INTERNAL_URL="http://localhost:3000"

# Back-office login. A single shared username/password, submitted on the /login
# form, gating every route except the customer order-token flow (/order/:token).
# Temporary, very-basic protection — see openspec/changes/add-backoffice-login.
BACKOFFICE_AUTH_USER="admin"
BACKOFFICE_AUTH_PASSWORD="change-me"

# Signing secret for the back-office session cookie. Rotating it invalidates
# every active session at once (the way to force everyone to log in again).
BACKOFFICE_SESSION_SECRET="change-me-to-a-long-random-string"

# Whether the session cookie is marked `Secure`. Defaults to true, which is what
# you want whenever TLS is terminated in front of the app.
#
# Set this to "false" for a deployment served over plain HTTP on a real hostname
# (e.g. the homelab install at http://ppl-poc.home:3001). Browsers refuse to
# store a `Secure` cookie received over a non-secure origin, so leaving it on
# there makes login silently impossible: the cookie is dropped, the middleware
# sees no session, and every attempt bounces back to /login. Local development
# on `localhost` needs no opt-out — browsers treat localhost as trustworthy.
COOKIE_SECURE="false"

# Umami analytics (optional). The script is only injected on production builds
# (NODE_ENV=production); local `next dev` never tracks. These override the
# baked-in homelab defaults — leave unset to use them.
# NEXT_PUBLIC_UMAMI_HOST="http://umami.home:3000"
# NEXT_PUBLIC_UMAMI_WEBSITE_ID="92aac9e1-8f20-4385-ad2d-df7e99619fdf"
#
BACKOFFICE_AUTH_USER=1
BACKOFFICE_AUTH_PASSWORD=1
BACKOFFICE_SESSION_SECRET=abc123
COOKIE_SECURE="false"
